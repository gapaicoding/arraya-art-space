# Supabase project URL (Project Settings -> API -> Project URL).
# Safe to expose to the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (Project Settings -> API -> anon public).
# Safe to expose to the browser; RLS policies enforce access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings -> API -> service_role).
# NOT currently used by the app code (no server-side admin bypass exists),
# but reserved for future admin/maintenance scripts. NEVER expose this to
# the browser and NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
